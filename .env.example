# ── Public site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://360consultancy.pk

# Verified business contact details. Leave blank until verified — the site
# hides any blank item instead of showing invented details.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
# Only fill in once you hold the real registration/licence. Shown in the footer.
NEXT_PUBLIC_BUSINESS_REGISTRATION=

# ── Feature flag (server-enforced) ───────────────────────────
# Keep false until legal/regulatory prerequisites are confirmed (see docs/LAUNCH_CHECKLIST.md)
SERVICES_ENABLED=false

# ── Supabase (server only — never prefix with NEXT_PUBLIC_) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin session ────────────────────────────────────────────
# Generate: openssl rand -base64 48
SESSION_SECRET=

# ── Bank transfer details (shown only in payment instructions) ─
BANK_ACCOUNT_TITLE=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BRANCH=

# ── Transactional email (optional until credentials exist) ───
# Supported: resend. Leave blank to disable; nothing is ever reported as sent.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

# Wizard lead saving. Off unless exactly "true". Enable only after the privacy policy is final.
LEADS_ENABLED=false

# Online payments. Leave blank: no provider has approved the business, payments are manual bank transfer.
# The webhook (/api/webhooks/payments) answers 404 until an adapter exists in src/lib/payments/provider.ts and this names it.
PAYMENT_PROVIDER=

# Client portal (accounts, uploads, 3 paid stages). OFF unless exactly "true" AND SERVICES_ENABLED=true.
# Needs the private storage bucket from migration 0006 and the Supabase service-role key.
PORTAL_ENABLED=false

# ── Analytics / SEO (optional; nothing loads while blank) ────
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ4. Mention analytics in the Privacy Policy first.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (the content="..." value).
NEXT_PUBLIC_GSC_VERIFICATION=

# NOWPayments (crypto gateway for portal case payments). Both required to enable; otherwise bank-transfer flow is shown.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Currency fees are priced in on the invoice. "pkr" if your NOWPayments account supports it; otherwise "usd" and set PKR_PER_USD.
NOWPAYMENTS_PRICE_CURRENCY=pkr
PKR_PER_USD=
# Empty = client picks any coin enabled in your NOWPayments account. Or force one, e.g. usdtbsc, usdterc20, usdtsol, btc.
NOWPAYMENTS_PAY_CURRENCY=
# Full IPN callback URL. Must be the final (non-redirecting) host, e.g. https://www.360consultancy.pk/api/webhooks/nowpayments
NOWPAYMENTS_IPN_URL=
EMAIL_REPLY_TO=
